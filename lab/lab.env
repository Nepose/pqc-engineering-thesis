# Pinned versions and addressing of the test bed, sourced by every script in lab/.
# TODO(Lx) values are confirmed in build step Lx (lab/README.md).

# --- Versions ---------------------------------------------------------------
# Latest release on 2026-11-18. The .sig verified as a good signature by release key
# 948F 158A 4E76 A27B F3D0 7532 DF42 C170 B34D BA77, the key ID published on
# www.strongswan.org/download.html; keyserver.ubuntu.com serves the same fingerprint.
STRONGSWAN_VERSION="6.1.0"
STRONGSWAN_SHA256="fe6c97481298767213cfc2e9a1da29fdd8018d481ff4cb9cf0283099654f20d4"
STRONGSWAN_URL="https://download.strongswan.org/strongswan-${STRONGSWAN_VERSION}.tar.bz2"

# --- Measured networks (Lima user-v2, option A) ------------------------------
# TODO(L0): keep option A only if lab/checks/link-check.sh passes.
NET_LEFT="pqc-left"
NET_LEFT_GW_CIDR="10.10.1.1/24"
NET_RIGHT="pqc-right"
NET_RIGHT_GW_CIDR="10.10.2.1/24"

# --- Static addresses (clear of Lima's DHCP leases, which start at .1) --------
# TODO(L0): confirm in ~/.lima/_networks/<net>/leases.json.
PREFIX_LEN=24
LEFT_NET="10.10.1.0/24"
RIGHT_NET="10.10.2.0/24"
INI_IP="10.10.1.100"
WAN_LEFT_IP="10.10.1.200"
WAN_RIGHT_IP="10.10.2.200"
RESP_IP="10.10.2.100"

# --- LANs behind the gateways (network namespace "lan" on each peer) ---------
INI_LAN="172.16.1.0/24"
INI_LAN_GW="172.16.1.1"
INI_LAN_HOST="172.16.1.10"
RESP_LAN="172.16.2.0/24"
RESP_LAN_GW="172.16.2.1"
RESP_LAN_HOST="172.16.2.10"

# --- IKE identities ---------------------------------------------------------
INI_ID="ini.pqc.lab"
RESP_ID="resp.pqc.lab"

# --- Paths inside the VMs ----------------------------------------------------
LAB_VM_DIR="/opt/pqc-lab"
LAB_STATE_DIR="/var/lib/pqc-lab"  # lab PKI, Wireshark keys, build info
LAB_LOG_DIR="/var/log/pqc-lab"
