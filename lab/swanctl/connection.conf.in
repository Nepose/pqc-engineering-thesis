# Generated by lab/swanctl/render.sh; do not edit.
# Configuration @ID@: @ROLE_NOTE@
connections {
    @ID@ {
        version = 2
        local_addrs = @LOCAL_ADDR@
        remote_addrs = @REMOTE_ADDR@
        proposals = @IKE_PROPOSAL@
        fragmentation = yes
        # Rekeying is triggered explicitly by scenarios S2-S5.
        rekey_time = 0
        reauth_time = 0
        local {
            auth = pubkey
            certs = pqc-lab.cert.pem
            id = @LOCAL_ID@
        }
        remote {
            auth = pubkey
            id = @REMOTE_ID@
        }
        children {
            @ID@-lan {
                local_ts = @LOCAL_TS@
                remote_ts = @REMOTE_TS@
                esp_proposals = @ESP_PROPOSAL@
                mode = tunnel
                rekey_time = 0
            }
        }
    }
}
